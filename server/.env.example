# ---------------------------------------------------------------------------
# 服务基础配置
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL 连接地址（请替换为真实凭据，不要提交生产密码）
DATABASE_URL=postgresql://qicheng:qicheng_local_dev@localhost:5432/qicheng?schema=public

# 允许访问 API 的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# 对外访问地址，用于生成上传文件访问链接
PUBLIC_BASE_URL=http://localhost:4000

LOG_LEVEL=info
DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# 会话与登录
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=qicheng_session
SESSION_TTL_HOURS=168
# 生产环境默认 true；仅在纯 HTTP 的本地开发环境设为 false
# COOKIE_SECURE=false
SESSION_SLIDING=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# 文件上传
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2097152
# 外部生成服务读取图片的签名密钥；生产环境必须显式设置并保持稳定
UPLOAD_SIGNING_SECRET=
UPLOAD_SIGNED_URL_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# 生成服务模式（与前端数据模式相互独立）
#   mock: 后端模拟 Provider，结果标记为演示数据
#   real: 调用外部服务；必须同时配置 URL 与 Token，否则返回 PROVIDER_NOT_CONFIGURED
# ---------------------------------------------------------------------------
SCRIPT_PROVIDER=mock
PROFILE_PROVIDER=mock
SCENE_PROVIDER=mock

SCRIPT_PROVIDER_URL=
SCRIPT_PROVIDER_TOKEN=
PROFILE_PROVIDER_URL=
PROFILE_PROVIDER_TOKEN=
SCENE_PROVIDER_URL=
SCENE_PROVIDER_TOKEN=
PROVIDER_TIMEOUT_MS=30000

# 模拟场景任务的排队 / 生成耗时（毫秒）
MOCK_SCENE_QUEUE_MS=1500
MOCK_SCENE_GENERATE_MS=5000
TASK_POLL_INTERVAL_MS=1000
ENABLE_TASK_RUNNER=true

# ---------------------------------------------------------------------------
# 测试数据库（与开发库分离；运行 npm test 前设置）
# TEST_DATABASE_URL=postgresql://qicheng:qicheng_local_dev@localhost:5432/qicheng_test?schema=public

# 首次管理员初始化（仅 npm run create-admin 使用，不要写入仓库）
# ---------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=请设置至少8位的本地密码
# ADMIN_DISPLAY_NAME=系统管理员
